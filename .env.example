# Generate secure secret key: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Django debugging mode -> IMPORTANT! Switch to False in production.
DEBUG=True

# Allowed client hosts -> only 'localhost' in development
ALLOWED_HOSTS=localhost,127.0.0.1

# IMPORTANT: DB credentials are only applied when the volume is first initialized.
# Changing them later has no effect on the database -> authentication errors.
# To reset in development: docker compose down -v (deletes all data).

# --------------
# DATABASE: PostgreSQL settings
# Postgres database name, host and port
# Postgres database user and password

POSTGRES_DB=cratedigger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cratedigger
# Generate secure password with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# -------------
# DATABASE: MongoDB settings
# MongoDB name, host and port
# MongoDB root user, also used by the app (dev shortcut, not least privilege)

MONGO_DB=lyricsdb
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
# Generate secure password with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
MONGO_PASSWORD=change-me
